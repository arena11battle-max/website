# ---------- Server (docker compose reads this file) ----------
# Database password (any long random text).
DB_PASSWORD=change-me-to-a-long-random-password
# Signs logins and encrypts hub device secrets. 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=change-me-to-32-or-more-random-characters
# Set to true only when the site is served over HTTPS (e.g. behind a domain with a certificate).
COOKIE_SECURE=false
# Game rules.
MAX_PLAYERS=8
RESPAWN_SECONDS=8
# Venue time zone, used for "Today" on the leaderboard.
TIME_ZONE=Asia/Kolkata
# Extra browser origins allowed to call the API (comma separated). Leave empty: the site calls its own server.
CORS_ORIGINS=

# ---------- Hardware bridge (bridge/ reads these, or bridge/config.json) ----------
# Where the bridge sends events, and the hub device created under Command > Settings > Hub devices.
SERVER_URL=http://localhost:8080
DEVICE_ID=
DEVICE_SECRET=

# ---------- Online Payments (Razorpay) ----------
# Get these from Razorpay Dashboard -> Settings -> API Keys & Webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Customer Mobile OTP ----------
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
